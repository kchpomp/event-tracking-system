---
import { buttonVariants } from '@/components/ui/button'
import BrandMark from './BrandMark.astro'

interface Props {
  actions: { login: string; signup: string } | null
}

const { actions } = Astro.props
---

<header class="sticky top-0 z-40 border-b border-border bg-background">
  <div class="site-container flex h-16 items-center justify-between gap-2">
    <a class="min-w-0 shrink rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" href="/">
      <BrandMark compact />
    </a>
    {
      actions && (
        <nav class="flex shrink-0 items-center gap-1.5 sm:gap-2" aria-label="Вход в приложение">
          <a class={buttonVariants({ className: 'h-10 px-2 text-xs min-[370px]:h-11 min-[370px]:px-2.5 min-[370px]:text-sm sm:px-4', size: 'sm', variant: 'outline' })} href={actions.login}>
            Войти
          </a>
          <a class={buttonVariants({ className: 'h-10 px-2 text-xs font-bold min-[370px]:h-11 min-[370px]:px-2.5 min-[370px]:text-sm sm:px-4', size: 'sm' })} href={actions.signup}>
            <span class="sm:hidden">Регистрация</span>
            <span class="hidden sm:inline">Зарегистрироваться</span>
          </a>
        </nav>
      )
    }
  </div>
</header>
