---
// One square cell of the SIBUR "partnership pattern": a flat fill with, at most, a single simple
// figure in another brand color. Colors come from theme tokens, so the cell follows `bun run theme`.
interface Props {
  base: 'brand' | 'primary' | 'secondary'
  figure?: 'background' | 'brand' | 'primary'
  shape?: 'circle' | 'quarter' | 'square'
}

const { base, figure = 'primary', shape } = Astro.props

const baseFill = { brand: 'fill-brand', primary: 'fill-primary', secondary: 'fill-secondary' }[base]
const figureFill = {
  background: 'fill-background',
  brand: 'fill-brand',
  primary: 'fill-primary',
}[figure]
---

<svg class="block aspect-square w-full" viewBox="0 0 100 100" aria-hidden="true">
  <rect class={baseFill} width="100" height="100"></rect>
  {shape === 'circle' && <circle class={figureFill} cx="50" cy="50" r="30"></circle>}
  {shape === 'quarter' && <path class={figureFill} d="M0 100V28A72 72 0 0 1 72 100Z"></path>}
  {shape === 'square' && <rect class={figureFill} x="30" y="30" width="40" height="40"></rect>}
</svg>
