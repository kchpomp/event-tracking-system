---
import EntryHero from '@/components/landing/EntryHero.astro'
import SiteFooter from '@/components/landing/SiteFooter.astro'
import SiteHeader from '@/components/landing/SiteHeader.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getEntryActions } from '@/lib/landing-actions'

const title = 'Формула Будущего'
const description =
  'Знакомьтесь с коллегами, предлагайте идеи и проходите интерактивы форума: ваш вклад складывается в «Индекс влияния».'
const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = publicWebsiteUrl
  ? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
  : undefined
const actions = getEntryActions(import.meta.env.PUBLIC_WEBAPP_URL)
---

<BaseLayout canonicalUrl={canonicalUrl} description={description} title={title}>
  <SiteHeader actions={actions} />
  <main id="main-content">
    <EntryHero actions={actions} />
  </main>
  <SiteFooter />
</BaseLayout>
